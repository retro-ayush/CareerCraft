# Copy to .env.local and fill in. Never commit real values.
# Every variable is read on the server only; none is exposed to the browser.

# --- AI provider (set at least one; Groq is used when both are set) ---
# Groq (OpenAI-compatible tool calling): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
# Secret (service_role) key. Server only: used by API routes and agent tools.
SUPABASE_SECRET_KEY=

# --- Access ---
# Shared team passcode. Also the signing key for session cookies: changing it signs everyone out.
APP_PASSCODE=
